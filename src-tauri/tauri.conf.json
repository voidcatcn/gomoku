{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lianzhu",
  "version": "1.0.0",
  "identifier": "com.lianzhu.gomoku",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "连珠 · 五子棋",
        "width": 1280,
        "height": 900,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#f2ede3"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "连珠 · 五子棋",
    "longDescription": "可同屏双人对弈或挑战本地引擎的五子棋。跨平台、可离线、棋谱不出本机。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
